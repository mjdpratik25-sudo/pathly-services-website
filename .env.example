# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/fixitt_services

# API server port (default: 5000)
PORT=5000

# -----------------------------------------------------------------------------
# Google Maps JavaScript API — main dashboard live GIS map
# -----------------------------------------------------------------------------
# Vite exposes only `VITE_`-prefixed vars to the browser, so the map component
# reads VITE_GOOGLE_MAPS_API_KEY (src/components/maps/GoogleNERMap.tsx). Set the
# same key in both vars below (add this to artifacts/Pathly-services-website/.env.local).
#
# Google Cloud Console checklist for local development:
#   1. Enable the "Maps JavaScript API" in the Google Cloud project.
#   2. Ensure Google Cloud Billing is active (no billing = "Oops! ... didn't load" error).
#   3. Add `http://localhost:*` to the API key's HTTP Referrer restrictions.
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here
GOOGLE_MAPS_API_KEY=your_api_key_here
